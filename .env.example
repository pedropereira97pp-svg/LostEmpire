# Supabase Configuration
# Copy this file to .env and fill in your actual values
# Get these from: https://supabase.com/dashboard/project/_/settings/api
#
# Primary environment variables (recommended for Expo):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
#
# Fallback aliases (also supported):
# SUPABASE_URL, REACT_APP_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_ANON_KEY, REACT_APP_SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY, VITE_SUPABASE_ANON_KEY
#
# Required format:
# EXPO_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
